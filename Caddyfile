{
    order rate_limit before reverse_proxy
}

dag.omid.consulting {
    handle /webhook/* {
        request_body {
            max_size 2KB
        }
        rate_limit {
            zone per_visitor {
                key    {remote_host}
                events 3
                window 8760h
            }
            zone everyone {
                key    all
                events 70
                window 24h
            }
        }
        reverse_proxy n8n:5678
    }
    handle {
        root * /srv
        file_server
    }
}